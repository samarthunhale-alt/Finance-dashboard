# Port the API listens on (Render injects PORT automatically)
PORT=5000

# MongoDB Atlas connection string (include the database name, e.g. /finance_dashboard)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/finance_dashboard?retryWrites=true&w=majority

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed by CORS. Comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173

# Optional
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional: creates (or promotes) this account as the admin on server start
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
